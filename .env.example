# Copy to .env and fill in. Never commit .env to version control.

# Required: Discord Incoming Webhook URL (channel → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Required: people and their school class page. Format: Name|ClassLabel|URL (comma-separated).
# Name = person (shown in digest). ClassLabel = e.g. 6B (shown as "Name (6B)"). Update each year.
PERSON_SCHOOL=Alice|6B|https://example.com/school/6b,Bob|8B|https://example.com/school/8b

# Optional: per-person notes (e.g. subject swaps, group info). Name must match PERSON_SCHOOL; key = SPECIAL_INFO_<Name uppercased, spaces to _>.
# Purely a human-readable note shown in the digest - it does not filter anything; see SUPPRESS_SUBJECTS below for that.
# SPECIAL_INFO_OLLE=Franska, Tyska (har Spanska istället)

# Optional: subjects to leave out of a person's Skola section entirely (e.g. a subject they don't
# take). Comma-separated, matched case-insensitively against the Veckoplanering "Ämne" column.
# Same <Name> key format as SPECIAL_INFO. Combine with SPECIAL_INFO_<Name> above for a human note.
# SUPPRESS_SUBJECTS_OLLE=Franska,Tyska

# Optional: calendars per person or shared. Format: Names|ICS_URL (comma between entries).
# Names = one person (Alice) or several separated by ; for a shared calendar (Alice;Bob).
# Use name "Familjen" for a calendar where the whole family does something together; it is highlighted in the weekly summary.
# PERSON_CALENDARS=Alice|https://...,Familjen|webcal://...,Bob|https://...

# Optional (fallback): global ICS URLs when PERSON_CALENDARS is not set. Comma-separated. webcal:// OK.
# ICS_URLS=https://calendar.icloud.com/...

# Optional: timezone for calendar week and event times (e.g. Europe/Stockholm). Default: Europe/Stockholm.
# CALENDAR_TIMEZONE=Europe/Stockholm

# Optional: LLM for weekly overview. Set ANTHROPIC_API_KEY to have Claude write the digest from school + calendar.
# Requires: pip install anthropic. Model: ANTHROPIC_DIGEST_MODEL (default claude-sonnet-5).
# Get a key at https://console.anthropic.com (separate from a claude.ai Pro/Max subscription - this is billed pay-per-token).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_DIGEST_MODEL=claude-sonnet-5
#   Other Messages API models: claude-opus-5, claude-haiku-4-5. See https://docs.claude.com/en/docs/about-claude/models

# Optional: directory for week snapshots (Sunday capture; weekday --check-updates diff). Default: .digest_snapshots
# DIGEST_SNAPSHOT_DIR=.digest_snapshots

# Legacy: SCHOOL_CLASSES=Label|URL,... still works (treated as Label for both name and class).
